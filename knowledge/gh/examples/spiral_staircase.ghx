                    <chunk name="Script">
                      <items count="2">
                        <item name="SourceCode" type_name="gh_string" type_code="10">import Rhino.Geometry as rg
import math

# Inputs: height, outer_r, inner_r, steps, rail_h, thick
n = int(steps)
step_h = height / n
angle_step = 2 * math.pi / n
rail_radius = 0.025
support_radius = 0.015

treads = []
supports = []
handrail_pts = []

for i in range(n):
    z = i * step_h
    a1 = i * angle_step
    a2 = (i + 1) * angle_step

    # Wedge tread: 4 corner points
    p1 = rg.Point3d(inner_r * math.cos(a1), inner_r * math.sin(a1), z)
    p2 = rg.Point3d(outer_r * math.cos(a1), outer_r * math.sin(a1), z)
    p3 = rg.Point3d(outer_r * math.cos(a2), outer_r * math.sin(a2), z)
    p4 = rg.Point3d(inner_r * math.cos(a2), inner_r * math.sin(a2), z)

    # Create wedge as closed polyline, extrude
    pts = [p1, p2, p3, p4, p1]
    pline = rg.Polyline(pts)
    curve = pline.ToNurbsCurve()
    vec = rg.Vector3d(0, 0, thick)
    tread = rg.Extrusion.Create(curve, thick, True)
    if tread:
        treads.append(tread.ToBrep())

    # Handrail points at outer edge mid-angle
    mid_a = (a1 + a2) / 2
    hr_pt = rg.Point3d(outer_r * math.cos(mid_a), outer_r * math.sin(mid_a), z + rail_h)
    handrail_pts.append(hr_pt)

    # Vertical support at mid-angle
    base_pt = rg.Point3d(outer_r * math.cos(mid_a), outer_r * math.sin(mid_a), z + thick)
    top_pt = rg.Point3d(outer_r * math.cos(mid_a), outer_r * math.sin(mid_a), z + rail_h)
    line = rg.Line(base_pt, top_pt)
    pipe = rg.Brep.CreatePipe(line.ToNurbsCurve(), support_radius, False, rg.PipeCapMode.Flat, True, 0.01, 0.01)[0]
    if pipe:
        supports.append(pipe)

# Add final handrail point at top
final_a = n * angle_step
handrail_pts.append(rg.Point3d(outer_r * math.cos(final_a), outer_r * math.sin(final_a), height + rail_h))

# Create handrail as interpolated curve, then pipe
if len(handrail_pts) > 1:
    rail_curve = rg.Curve.CreateInterpolatedCurve(handrail_pts, 3)
    handrail_breps = rg.Brep.CreatePipe(rail_curve, rail_radius, False, rg.PipeCapMode.Round, True, 0.01, 0.01)
    handrail = handrail_breps[0] if handrail_breps else None
else:
    handrail = None

# Central spine cylinder
plane = rg.Plane.WorldXY
circle = rg.Circle(plane, inner_r)
spine = rg.Extrusion.CreateCylinderExtrusion(circle, height, True)
spine = spine.ToBrep() if spine else None</item>
