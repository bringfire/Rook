                    <chunk name="param_output" index="3">
                      <items count="5">
                        <item name="Description" type_name="gh_string" type_code="10">Vertical supports</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">77778004-7777-7777-7777-777777777777</item>
                        <item name="Name" type_name="gh_string" type_code="10">supports</item>
                        <item name="NickName" type_name="gh_string" type_code="10">supports</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
