        {
          "step": "3",
          "title": "LOAD",
          "text": "LOAD\r\nOnce a Field has been saved with the SaveField component,\r\nit can be quickly reloaded in Grasshopper using the LoadField\r\ncomponent. This allows to split Field generation and aggregation\r\nin two separate files, avoiding costly computing.\r\nThe LOAD input can be triggered with a button to reload the file\r\nafter changes.",
          "nearby_components": [
            "Button",
            "Wasp_Update File",
            "Curve",
            "Point",
            "File Path",
            "Geometry",
            "Wasp_Load Field from File",
            "Wasp_Connection From Direction"
          ],
          "annotation_type": "Scribble",
          "pos": [
            62.3,
            362.1
          ]
        },
        {
          "step": "4",
          "title": "SAVE",
          "text": "SAVE\r\nFields can be saved to file and reloaded in a second\r\nmoment or in another file.\r\nThis is particularly useful when working with very large\r\nand complex fields, which can be computed only once\r\nand then reloaded from file (loading from file is faster \r\nthan re-generating the whole field).",
          "nearby_components": [
            "Custom Preview",
            "Wasp_Field",
            "Gradient"
          ],
          "annotation_type": "Scribble",
