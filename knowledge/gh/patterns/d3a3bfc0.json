      "curriculum": [
        {
          "step": "1",
          "title": "Press the button to make sure the file is",
          "text": "Press the button to make sure the file is\r\nupdated to latest Wasp version on your pc.",
          "nearby_components": [
            "Button"
          ],
          "annotation_type": "Scribble",
          "pos": [
            -334.2,
            -7.6
          ]
        },
        {
          "step": "2",
          "title": "4_03_Wasp_to_DisCo",
          "text": "4_03_Wasp_to_DisCo",
          "nearby_components": [
            "Wasp_Update File"
          ],
          "annotation_type": "Scribble",
          "pos": [
            41.7,
            36
          ]
        },
        {
          "step": "3",
          "title": "WASP PARTS FOR DISCO",
          "text": "WASP PARTS FOR DISCO\r\nDisCo works in meters, so the Rhino file should\r\nalso be in meters, and the size of the parts should\r\nbe compatible to what can be manipulated in VR.",
          "nearby_components": [
            "Brep",
            "Wasp_Update File",
            "Point",
            "Curve",
            "Wasp_Connection From Direction"
          ],
          "annotation_type": "Scribble",
          "pos": [
            94.2,
            151.5
          ]
        },
        {
          "step": "4",
          "title": "RULES FILTERS",
          "text": "RULES FILTERS\r\nThe same rules grammars set in Wasp will be available\r\nin DisCo as rule filters, allowing to activate and deactivate\r\ndifferent rules during the VR choreographing process.",
          "nearby_components": [
            "Wasp_Basic Part",
            "Merge",
            "Wasp_Rules Generator",
            "Merge",
            "Wasp_DisCo Rule Group",
            "Unit Z",
            "NumberSlider",
            "Move"
          ],
          "annotation_type": "Scribble",
          "pos": [
            978.6,
            869.6
          ]
        },
        {
          "step": "5",
          "title": "RULE GROUPS",
          "text": "RULE GROUPS\r\nThe different connection grammars can be grouped.\r\nThese groups will be available on the DisCo controller,\r\nto quickly switch on and off several rule filters at once.",
          "nearby_components": [
            "Wasp_DisCo Rule Group",
            "Wasp_Basic Part",
            "Wasp_DisCo Rule Group",
            "Wasp_Rules Generator",
            "Merge",
            "Merge",
            "Merge",
            "Toggle"
          ],
          "annotation_type": "Scribble",
          "pos": [
            1015.8,
            1027
          ]
        },
        {
          "step": "6",
          "title": "LOAD FROM DISCO",
          "text": "LOAD FROM DISCO\r\nThis component allows to load a DisCo-generated aggregation into Grasshopper.\r\nThe imported aggregation can be used as base for further aggregation\r\nby plugging the PART_OUT output to the PREV input of\r\nan aggregation component.",
          "nearby_components": [
            "Wasp_DisCo IO Settings",
            "Toggle",
            "Toggle",
            "Wasp_DisCo Placement Settings",
            "Toggle",
            "Button",
            "Toggle",
            "Wasp_Load From DisCo"
          ],
          "annotation_type": "Scribble",
          "pos": [
            2327.8,
            1952
          ]
        },
        {
          "step": "7",
          "title": "PLAYER SETTINGS",
          "text": "PLAYER SETTINGS\r\nFor the new multiplayer mode of DisCo, these components\r\nenable to setup different players with different tools and\r\nconstraints applied to each of them.",
          "nearby_components": [
            "Toggle",
            "Toggle"
          ],
          "annotation_type": "Scribble",
          "pos": [
            2528.4,
            1060.5
          ]
        },
        {
          "step": "8",
          "title": "SAVE TO DISCO",
          "text": "SAVE TO DISCO\r\nThis allows to save a Grasshopper-generated aggregation\r\nto load it in DisCo for further aggregation in VR.",
          "nearby_components": [
            "Wasp_DisCo IO Settings",
            "Toggle",
            "Wasp_DisCo Placement Settings",
            "Toggle"
          ],
          "annotation_type": "Scribble",
          "pos": [
            2601.6,
            1706
          ]
        },
        {
          "step": "9",
          "title": "ENVIRONMENT SETTINGS",
          "text": "ENVIRONMENT SETTINGS\r\nSettings for the different parameters of the\r\ngame environment, including additional geometries\r\nand blueprints.",
