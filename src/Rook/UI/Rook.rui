    <macro_item guid="c8d9e0f1-a2b3-4c4d-5e6f-7a8b9c0d1e2f" bitmap_id="0d1e2f3a-4b5c-4d6e-7f8a-9b0c1d2e3f4a">
      <text>
        <locale_1033>AI Gumball</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Toggle AI Gumball mode</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Enable/disable AI Gumball mode. Captures every drag with full transform data.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>AI Gumball</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>AI Gumball</locale_1033>
      </menu_text>
      <script>! _AIGumball</script>
    </macro_item>
    <macro_item guid="d9e0f1a2-b3c4-4d5e-6f7a-8b9c0d1e2f3a" bitmap_id="2a3b4c5d-6e7f-4a9b-0c1d-e2f3a4b5c6d7">
      <text>
        <locale_1033>Show Rook Panel</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Show Rook control panel</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Opens the Rook panel showing server status and controls.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Bridge Panel</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Rook Panel</locale_1033>
      </menu_text>
      <script>! _ShowRookPanel</script>
    </macro_item>
    <macro_item guid="f1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c" bitmap_id="4c5d6e7f-8a9b-4c1d-2e3f-a4b5c6d7e8f9">
      <text>
        <locale_1033>Show Rook Chat Panel</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Open Rook Chat panel</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Opens the interactive Rook Chat panel for AI-assisted modeling directly in Rhino.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Rook Chat</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Rook Chat Panel</locale_1033>
      </menu_text>
      <script>! _ShowRookChat</script>
    </macro_item>
    <macro_item guid="a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6d" bitmap_id="5d6e7f8a-9b0c-4d2e-3f4a-b5c6d7e8f9a0">
      <text>
        <locale_1033>Start Rook</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Start the Rook HTTP server</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Starts the Rook HTTP server if it is not already running.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Start</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Start Rook</locale_1033>
      </menu_text>
      <script>! _StartRook</script>
    </macro_item>
    <macro_item guid="b3c4d5e6-f7a8-4b9c-0d1e-2f3a4b5c6d7e" bitmap_id="6e7f8a9b-0c1d-4e3f-4a5b-c6d7e8f9a0b1">
      <text>
        <locale_1033>Stop Rook</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Stop the Rook HTTP server</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Stops the Rook HTTP server.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Stop</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Stop Rook</locale_1033>
      </menu_text>
      <script>! _StopRook</script>
    </macro_item>
    <macro_item guid="c4d5e6f7-a8b9-4c0d-1e2f-3a4b5c6d7e8f" bitmap_id="7a8b9c0d-1e2f-4a3b-4c5d-6e7f8a9b0c1d">
      <text>
        <locale_1033>UV Box Mapping</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Apply oriented box UV mapping to selected objects</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Applies object-oriented box UV mapping. Analyzes geometry edges to auto-orient the mapping to the dominant direction. Scale defaults to 1 UV unit = 1 meter.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>UV Map</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>UV Box Mapping</locale_1033>
      </menu_text>
      <script>! _UVBoxMapping</script>
    </macro_item>
