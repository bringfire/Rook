<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net7.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);ROOK_WEBVIEW2</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">$(ProgramFiles)\Rhino 8\System</RhinoSystemDir>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.6.0</Version>
    <Title>Rook</Title>
    <Company>Bringfire</Company>
    <Description>Rook for Rhino 3D - HTTP server enabling AI-powered CAD operations</Description>
    <Authors>Bringfire</Authors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rook.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../RookBim/bin/$(Configuration)/$(TargetFramework)/RookBim.dll"
          Condition="Exists('../RookBim/bin/$(Configuration)/$(TargetFramework)/RookBim.dll')">
      <Link>RookBim.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../RookBim/bin/$(Configuration)/$(TargetFramework)/RookBim.pdb"
          Condition="Exists('../RookBim/bin/$(Configuration)/$(TargetFramework)/RookBim.pdb')">
      <Link>RookBim.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net7.0'">
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\netcore\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rhino.UI">
      <HintPath>$(RhinoSystemDir)\netcore\Rhino.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eto">
      <HintPath>$(RhinoSystemDir)\Eto.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net7.0'" />
    <!-- DPAPI for secure API key storage. Multi-target: NuGet package
         supports net462+ so all managed target frameworks get it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- WebView2 wrapper assemblies are packaged with each runtime child;
         the Evergreen WebView2 Runtime still comes from the host machine. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1938.49" />
    <!-- HttpClient for net48 -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <!-- Embedded resources for WebUI surfaces -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Chat\Resources\**\*" />
    <EmbeddedResource Include="UI\Knowledge\Resources\**\*" />
    <EmbeddedResource Include="UI\Vision\Resources\**\*" />
    <EmbeddedResource Include="Services\Reconstruction\Fal\fal-model-catalog.json" />
  </ItemGroup>

  <!-- Deploy companion plugin to Rhino's plugin directory after build.
       Mirrors the installer multi-runtime layout for local development. -->
  <PropertyGroup>
    <RhinoPluginDir>$(APPDATA)\McNeel\Rhinoceros\8.0\Plug-ins\RookNative</RhinoPluginDir>
  </PropertyGroup>

  <Target Name="DeployToRhino" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' != '' AND Exists('$(RhinoPluginDir)')">
    <PropertyGroup>
      <RhinoManagedRuntimeDir>$(RhinoPluginDir)\$(TargetFramework)</RhinoManagedRuntimeDir>
    </PropertyGroup>
    <ItemGroup>
      <RookRuntimeDependencyFiles Include="$(TargetDir)*.dll" />
      <RookRuntimeAssetFiles Include="$(TargetDir)runtimes\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(RhinoManagedRuntimeDir)" />
    <Delete Files="$(RhinoManagedRuntimeDir)\$(TargetName).rui" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RhinoManagedRuntimeDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json"
          DestinationFolder="$(RhinoManagedRuntimeDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).runtimeconfig.json"
          DestinationFolder="$(RhinoManagedRuntimeDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).runtimeconfig.json')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(RhinoManagedRuntimeDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(RookRuntimeDependencyFiles)"
          DestinationFolder="$(RhinoManagedRuntimeDir)" SkipUnchangedFiles="true"
          Condition="'@(RookRuntimeDependencyFiles)' != ''" />
    <Copy SourceFiles="@(RookRuntimeAssetFiles)"
          DestinationFiles="@(RookRuntimeAssetFiles->'$(RhinoManagedRuntimeDir)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(RookRuntimeAssetFiles)' != ''" />
    <Message Importance="high" Text="Deployed Rook.rhp to $(RhinoManagedRuntimeDir)" />
  </Target>

</Project>
