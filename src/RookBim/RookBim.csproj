<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.6.0</Version>
    <Title>RookBIM</Title>
    <Company>Bringfire</Company>
    <Description>RookBIM for Rhino.Inside.Revit category and element queries</Description>
    <Authors>Bringfire</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">$(ProgramFiles)\Autodesk\Revit 2024</RevitInstallDir>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">$(ProgramFiles)\Rhino 8\System</RhinoSystemDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rook/Rook.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <RookRuntimeDir>../Rook/bin/$(Configuration)/$(TargetFramework)</RookRuntimeDir>
  </PropertyGroup>

  <Target Name="CopyRookBimToRookRuntime" AfterTargets="Build" Condition="Exists('$(RookRuntimeDir)')">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(RookRuntimeDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(RookRuntimeDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
