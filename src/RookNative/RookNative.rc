// RookNative.rc - Resource script
//
// Provides version information that Rhino reads when loading the plugin.

#include "Resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
// Version information
//
// Rhino reads this to display plugin info in the Plugin Manager.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,6,0,0
 PRODUCTVERSION 1,6,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bringfire"
            VALUE "FileDescription", "RookNative - High-performance Rhino bridge for Claude Code"
            VALUE "FileVersion", "1.6.0.0"
            VALUE "InternalName", "RookNative"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 Bringfire"
            VALUE "OriginalFilename", "RookNative.rhp"
            VALUE "ProductName", "Rook"
            VALUE "ProductVersion", "1.6.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
