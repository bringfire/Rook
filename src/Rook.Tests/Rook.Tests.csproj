<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">$(ProgramFiles)\Rhino 8\System</RhinoSystemDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Pin BCL packages to versions newer than RhinoCommon's transitive
         references to silence MSB3277 conflicts on net48. -->
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
    <!-- Rook excludes RhinoCommon runtime assets for plugin deployment, but
         xUnit needs the assembly beside Rook.Tests.dll for discovery. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rook\Rook.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real WPF dispatcher for the chat responsiveness test (System.Windows.Threading). -->
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- Rook.csproj outputs Rook.rhp (Rhino plugin convention), but the .NET
       runtime probes for Rook.dll during assembly resolution. Mirror the
       .rhp as .dll in the test bin so xUnit can load Rook types. -->
  <Target Name="MirrorRookRhpToDll" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)Rook.rhp"
          DestinationFiles="$(OutputPath)Rook.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)Rook.rhp')" />
  </Target>

  <Target Name="CopyRhinoCommonToTestOutput" AfterTargets="Build">
    <Copy SourceFiles="$(PkgRhinoCommon)\lib\net48\RhinoCommon.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PkgRhinoCommon)\lib\net48\RhinoCommon.dll')" />
  </Target>

  <Target Name="UseInstalledEtoForManagedUiTests" AfterTargets="CopyRhinoCommonToTestOutput">
    <Copy SourceFiles="$(RhinoSystemDir)\Eto.dll;$(RhinoSystemDir)\Eto.Wpf.dll;$(RhinoSystemDir)\Microsoft.WindowsAPICodePack.dll;$(RhinoSystemDir)\Microsoft.WindowsAPICodePack.Shell.dll;$(RhinoSystemDir)\Xceed.Wpf.Toolkit.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
